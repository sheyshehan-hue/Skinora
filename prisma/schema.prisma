// Skinora — data model
// Storefront, orders, inventory (batches / expiry / FEFO), promotions, CMS and analytics.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Staff & customers ─────────────────────────

enum StaffRole {
  ADMIN
  INVENTORY_MANAGER
  ORDER_HANDLER
}

model StaffUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole @default(ORDER_HANDLER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

model Customer {
  id             String               @id @default(cuid())
  email          String               @unique
  name           String
  phone          String?
  passwordHash   String? // null = guest checkout customer
  district       String?
  loyaltyPoints  Int                  @default(0)
  marketingOptIn Boolean              @default(false)
  locale         String               @default("en")
  skinType       String?
  createdAt      DateTime             @default(now())
  orders         Order[]
  addresses      Address[]
  reviews        Review[]
  loyalty        LoyaltyTransaction[]
  wishlist       WishlistItem[]
  skinScans      SkinScan[]
}

// AI skin analysis results. The selfie itself is never stored, only the scores.
model SkinScan {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  engine     String // "claude" or "device" (on-server estimate when no AI key is set)
  skinType   String
  concerns   String[]
  scores     Json // { hydration: 0-100, ... } higher is healthier
  overall    Int
  summary    String
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  line1      String
  line2      String?
  city       String
  district   String
  phone      String
  isDefault  Boolean  @default(false)
}

// ───────────────────────── Catalogue ─────────────────────────

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  origin      String? // country of origin, shown in import details
  featured    Boolean   @default(false)
  isLuxury    Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  sortOrder    Int        @default(0)
  translations Json? // { si: { name }, ta: { name } }
  products     Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  brandId         String
  brand           Brand               @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id])
  tagline         String?
  description     String
  ingredients     String              @default("")
  keyIngredients  String[]
  howToUse        String              @default("")
  skinTypes       String[] // dry, oily, combination, normal, sensitive
  concerns        String[] // acne, pigmentation, ageing, dryness, redness, dullness, pores
  gender          String? // women | men | unisex (fragrance)
  isLuxury        Boolean             @default(false)
  isNew           Boolean             @default(false)
  isBestSeller    Boolean             @default(false)
  featured        Boolean             @default(false)
  status          ProductStatus       @default(ACTIVE)
  originCountry   String?
  importer        String?             @default("Skinora Imports (Pvt) Ltd")
  translations    Json?
  metaTitle       String?
  metaDescription String?
  ratingAvg       Float               @default(0)
  ratingCount     Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  variants        Variant[]
  images          ProductImage[]
  reviews         Review[]
  collections     CollectionProduct[]
  bundleItems     BundleItem[]
  flashSales      FlashSaleProduct[]
  wishlistedBy    WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? // Cloudinary public id
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
}

model Variant {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String // e.g. "30 ml", "50 ml EDP"
  sku          String      @unique
  price        Int // LKR, whole rupees
  salePrice    Int?
  costPrice    Int         @default(0) // weighted landed import cost per unit
  stock        Int         @default(0) // sum of batch.remaining (denormalised)
  reorderLevel Int         @default(10)
  leadTimeDays Int         @default(21)
  sortOrder    Int         @default(0)
  batches      Batch[]
  orderItems   OrderItem[]
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  country String
  contact String?
  email   String?
  batches Batch[]
}

// Each import shipment is a batch with its own expiry. Stock is picked first-expiry-first-out.
model Batch {
  id             String      @id @default(cuid())
  variantId      String
  variant        Variant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batchNumber    String
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  quantity       Int
  remaining      Int
  unitCost       Int // landed cost per unit, LKR
  manufacturedAt DateTime?
  expiryDate     DateTime
  receivedAt     DateTime    @default(now())
  importRef      String? // customs / airway bill reference
  orderItems     OrderItem[]

  @@index([variantId, expiryDate])
}

model Review {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  rating     Int
  title      String?
  body       String
  skinType   String?
  verified   Boolean   @default(false)
  approved   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model WishlistItem {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
}

// ───────────────────────── Merchandising / CMS ─────────────────────────

model Collection {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  eyebrow     String?
  description String?
  imageUrl    String?
  featured    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([collectionId, productId])
}

enum BannerPlacement {
  HERO
  PROMO
  ANNOUNCEMENT
}

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement @default(HERO)
  eyebrow   String?
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  imageUrl  String?
  theme     String          @default("light") // light | dark
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
}

model Setting {
  key   String @id
  value Json
}

// ───────────────────────── Delivery ─────────────────────────

model DeliveryZone {
  district     String  @id
  province     String
  standardFee  Int // LKR
  expressFee   Int? // same-day (Colombo) or next-day
  sameDay      Boolean @default(false)
  nextDay      Boolean @default(false)
  etaDaysMin   Int     @default(2)
  etaDaysMax   Int     @default(4)
  codAvailable Boolean @default(true)
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  PAYHERE
  KOKO
  MINTPAY
  BANK_TRANSFER
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String            @id @default(cuid())
  number          String            @unique // SK-100245
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email           String
  phone           String
  name            String
  addressLine1    String
  addressLine2    String?
  city            String
  district        String
  deliveryMethod  String            @default("standard") // standard | express | same-day
  deliveryFee     Int
  subtotal        Int
  discount        Int               @default(0)
  giftWrap        Boolean           @default(false)
  giftWrapFee     Int               @default(0)
  giftMessage     String?
  loyaltyRedeemed Int               @default(0)
  total           Int
  promoCode       String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus     @default(PENDING)
  paymentRef      String?
  status          OrderStatus       @default(PENDING_PAYMENT)
  codCollected    Boolean           @default(false)
  codRemittedAt   DateTime?
  courier         String?
  trackingNumber  String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  returns         ReturnRequest[]
  notifications   NotificationLog[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant @relation(fields: [variantId], references: [id])
  batchId     String?
  batch       Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  productName String
  variantName String
  quantity    Int
  unitPrice   Int
  unitCost    Int

  @@index([variantId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REFUNDED
  REJECTED
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason       String
  status       ReturnStatus @default(REQUESTED)
  refundAmount Int          @default(0)
  restock      Boolean      @default(false)
  createdAt    DateTime     @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel   String // SMS | EMAIL
  to        String
  subject   String?
  message   String
  status    String   @default("LOGGED") // SENT | FAILED | LOGGED (no provider configured)
  createdAt DateTime @default(now())
}

// Carts that reached checkout; unconverted ones count as abandoned.
model CheckoutSession {
  id        String   @id @default(cuid())
  email     String?
  itemCount Int
  value     Int
  items     Json
  orderId   String?  @unique
  createdAt DateTime @default(now())
}

// ───────────────────────── Promotions & loyalty ─────────────────────────

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Int // percent or LKR
  minSpend    Int          @default(0)
  usageLimit  Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

model Bundle {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  price       Int // bundle price LKR
  active      Boolean      @default(true)
  items       BundleItem[]
}

model BundleItem {
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
}

model FlashSale {
  id              String             @id @default(cuid())
  name            String
  discountPercent Int
  startsAt        DateTime
  endsAt          DateTime
  active          Boolean            @default(true)
  products        FlashSaleProduct[]
}

model FlashSaleProduct {
  flashSaleId String
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([flashSaleId, productId])
}

model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int // +earned / -redeemed
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())
}
