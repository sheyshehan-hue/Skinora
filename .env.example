# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://skinora:skinora@localhost:5432/skinora?schema=public"

# --- Auth: long random string, e.g. `openssl rand -base64 32` ---
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Public site URL (used for SEO, PayHere return URLs) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="94771234567"

# --- SEO: verification codes from Google Search Console and Bing Webmaster Tools, and social profile URLs (comma-separated) for structured data ---
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
NEXT_PUBLIC_SOCIAL_LINKS=""

# --- Cloudinary (image storage). If empty, uploads are saved to /public/uploads (dev only) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- PayHere (https://www.payhere.lk). Leave empty to run payments in demo mode ---
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"

# --- Koko / Mintpay BNPL (merchant credentials from each provider) ---
KOKO_MERCHANT_ID=""
KOKO_API_KEY=""
MINTPAY_MERCHANT_ID=""
MINTPAY_API_KEY=""

# --- Order notifications. If empty, messages are only logged in the admin ---
NOTIFYLK_USER_ID=""
NOTIFYLK_API_KEY=""
NOTIFYLK_SENDER_ID="Skinora"
RESEND_API_KEY=""
EMAIL_FROM="Skinora <orders@skinora.lk>"
